+def _load_proxy_operator(
+    config_path: Path | None, source_path: Path | None
+) -> tuple[Any | None, dict[str, Any] | None, str | None]:
+    """Load the optional disease-repository action adapter."""
+
+    if config_path is None:
+        return None, None, None
+    if source_path is not None:
+        source = _resolve(source_path)
+        if (source / "src" / "drosophila_pd_neural").is_dir():
+            source = source / "src"
+        if not (source / "drosophila_pd_neural").is_dir():
+            raise BrainBodyRunError(
+                "Proxy adapter source must contain drosophila_pd_neural: "
+                f"{source}"
+            )
+        if str(source) not in sys.path:
+            sys.path.insert(0, str(source))
+    try:
+        import yaml
+        from drosophila_pd_neural.action_hook_adapter import (
+            apply_proxy_operator_to_locomotion_action,
+        )
+    except (ImportError, ModuleNotFoundError) as exc:
+        raise BrainBodyRunError(
+            "Proxy adapter is enabled but drosophila_pd_neural is unavailable. "
+            "Pass --proxy-operator-source pointing to the disease repository."
+        ) from exc
+    if not config_path.is_file():
+        raise BrainBodyRunError(f"Proxy operator config was not found: {config_path}")
+    document = yaml.safe_load(config_path.read_text(encoding="utf-8")) or {}
+    if not isinstance(document, dict):
+        raise BrainBodyRunError("Proxy operator config must be a mapping.")
+    config_sha256 = hashlib.sha256(config_path.read_bytes()).hexdigest()
+    return apply_proxy_operator_to_locomotion_action, document, config_sha256
+
+
